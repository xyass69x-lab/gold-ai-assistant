//@version=6
indicator("Gold AI Assistant - Selective Signals", overlay=true)

isGold = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD")
ema200 = ta.ema(close, 200)
ema50 = ta.ema(close, 50)
ema20 = ta.ema(close, 20)
rsi = ta.rsi(close, 14)
atr = ta.atr(14)

trendUp = close > ema200 and ema50 > ema200
trendDown = close < ema200 and ema50 < ema200
longConfirm = isGold and trendUp and low <= ema20 and close > ema20 and rsi > 52 and close > open
shortConfirm = isGold and trendDown and high >= ema20 and close < ema20 and rsi < 48 and close < open

// Educational ATR levels only. Backtest and validate contract sizing before live use.
longEntry = close
longSL = close - 1.5 * atr
longTP1 = close + 1.5 * atr
longTP2 = close + 3.0 * atr
shortEntry = close
shortSL = close + 1.5 * atr
shortTP1 = close - 1.5 * atr
shortTP2 = close - 3.0 * atr

plot(ema200, "EMA 200", color=color.orange, linewidth=2)
plot(ema50, "EMA 50", color=color.blue)
plot(ema20, "EMA 20", color=color.aqua)
plotshape(longConfirm and barstate.isconfirmed, title="BUY", style=shape.labelup, location=location.belowbar, color=color.green, text="BUY", textcolor=color.white)
plotshape(shortConfirm and barstate.isconfirmed, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.white)

if longConfirm and barstate.isconfirmed
    alert('{"symbol":"XAUUSD","side":"BUY","entry":' + str.tostring(longEntry, format.mintick) + ',"stop_loss":' + str.tostring(longSL, format.mintick) + ',"take_profit_1":' + str.tostring(longTP1, format.mintick) + ',"take_profit":' + str.tostring(longTP2, format.mintick) + ',"timeframe":"' + timeframe.period + '","reason":"اتجاه صاعد + إعادة اختبار EMA20 + زخم RSI"}', alert.freq_once_per_bar_close)

if shortConfirm and barstate.isconfirmed
    alert('{"symbol":"XAUUSD","side":"SELL","entry":' + str.tostring(shortEntry, format.mintick) + ',"stop_loss":' + str.tostring(shortSL, format.mintick) + ',"take_profit_1":' + str.tostring(shortTP1, format.mintick) + ',"take_profit":' + str.tostring(shortTP2, format.mintick) + ',"timeframe":"' + timeframe.period + '","reason":"اتجاه هابط + إعادة اختبار EMA20 + زخم RSI"}', alert.freq_once_per_bar_close)
